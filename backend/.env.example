# Copie este arquivo para .env e ajuste os valores.

# Porta e interface em que a API escuta. 0.0.0.0 aceita conexões do
# emulador Android e de celulares na mesma rede Wi-Fi.
PORT=3000
HOST=0.0.0.0

# PostgreSQL local (docker compose up -d):
DATABASE_URL=postgres://plotter:plotter@localhost:5432/plotter

# PostgreSQL do Supabase (Project Settings > Database > Connection string):
# DATABASE_URL=postgresql://postgres.<projeto>:<senha>@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# Previsão do tempo (Etapa 6) — serviço externo OpenWeatherMap.
# Crie uma conta gratuita em https://home.openweathermap.org/users/sign_up e
# copie a chave em "API keys". Chaves novas podem levar até 2 horas para
# serem ativadas. Coloque a chave verdadeira só no .env, nunca neste arquivo.
OPENWEATHER_API_KEY=

# Coordenadas da fazenda em graus decimais (sul e oeste são negativos).
# Exemplo: Rio Verde (GO).
FAZENDA_LAT=-17.7923
FAZENDA_LON=-50.9192

# Endereço do serviço (opcional; só muda para testes com servidor simulado).
# OPENWEATHER_URL=https://api.openweathermap.org/data/2.5
